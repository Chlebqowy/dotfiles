{{- $t := index .themes .theme }}
{{- $s := $t.seperator }}
{{- $st := $t.thick }}
{{- $r1 := index $t.primary_l 0 }}
{{- $g1 := index $t.primary_l 1 }}
{{- $b1 := index $t.primary_l 2 }}
{{- $r2 := index $t.primary_r 0 }}
{{- $g2 := index $t.primary_r 1 }}
{{- $b2 := index $t.primary_r 2 }}
{{- $rd := subf $r2 $r1 }}
{{- $gd := subf $g2 $g1 }}
{{- $bd := subf $b2 $b1 }}
{{- $rdp := divf $rd 100 }}
{{- $gdp := divf $gd 100 }}
{{- $bdp := divf $bd 100 -}}

"$schema" = 'https://starship.rs/config-schema.json'
palette = 'main'
format = """\
[$directory]()\
[$username]()\
[$time]()\
[$git_branch]()[$git_metrics]()[$git_state]()\
[$rust]()[$python]()[$cpp]()[$c]()\
[{{ $st }}](fg:primary_0)[{{ $st }}](fg:primary_25)[{{ $st }}](fg:primary_50)[{{ $st }}](fg:primary_75)[{{ $st }}](fg:primary_100)
[$os]()\
[$status]() \
"""

# cmd only
right_format = """\
[$battery]()
"""

[palettes.main]
{{ range $p := list 0 10 20 25 30 40 50 60 70 75 80 100 -}}
primary_{{ $p }} = "{{ printf "#%02x%02x%02x" (round (addf $r1 (mulf $rdp $p)) 0 | int) (round (addf $g1 (mulf $gdp $p)) 0 | int) (round (addf $b1 (mulf $bdp $p)) 0 | int) }}"
{{ end -}}

white_text = "{{ $t.white_text }}"
red_text = "{{ $t.red_text }}"
failure = "{{ $t.failure }}"

[directory]
truncation_length = 3
truncation_symbol = "..."
style = "fg:white_text"
read_only_style = "fg:red_text"
format = "[ ](fg:primary_0) [$path]($style) "

[time]
disabled = false
use_12hr = false
style = "fg:white_text"
format = "[{{ $s }} ](fg:primary_40)[$time]($style) "

[battery]
format = "[$percentage]($style)"

[[battery.display]]
style = "fg:white_text"
threshold=100

[username]
show_always = true
style_user = "fg:white_text"
style_root = "fg:red_text"
format = "[{{ $s }} ](fg:primary_20)[$user]($style) "

[status]
disabled = false
style = "fg:primary_100"
failure_style = "fg:failure"
symbol = "{{ $st }}"
success_symbol = "{{ $st }}"
#pipestatus = true
#pipestatus_format = "[$pipestatus] => [$common_meaning$signal_name$maybe_int $symbol ]($style)"
format = "[$symbol](fg:primary_50)[$symbol](fg:primary_75)[$symbol]($style)"

[git_branch]
truncation_length = 10
truncation_symbol = '...'
format = "[{{ $s }} ](fg:primary_60)[$branch]($style) "
style = "fg:white_text"

[git_metrics]
disabled = false
format = "[+$added]($added_style) (fg:secondary bg:gray)[-$deleted]($added_style) "
added_style = "fg:wbite_text"

[git_state]
format = "[$state]($style) [$progress_current/$progress_total]($style) "
style = "fg:white_text"

[rust]
disabled = false
format = "[{{ $s }} ](fg:primary_80)[ ](fg:primary_100)[$version]($style) "
style = "fg:wbite_text, bold"

[python]
disabled = false
format = "[{{ $s }} ](fg:primary_80)[ ](fg:primary_100)[$version]($style) "
style = "fg:wbite_text, bold"

[cpp]
disabled = false
format = "[{{ $s }} ](fg:primary_80)[ ](fg:primary_100)[$version]($style) "
style = "fg:wbite_text, bold"

[c]
disabled = false
format = "[{{ $s }} ](fg:primary_80)[ ](fg:primary_100)[$version]($style) "
style = "fg:wbite_text, bold"

[os]
disabled = false
style = "fg:primary_50 bg:gray, bold"
format = "[$symbol]($style)"

