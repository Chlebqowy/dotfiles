{{- $t := index .themes .theme }}
{{- $s := $t.seperator }}
{{- $st := $t.thick }}
{{- $stl := $t.thick_left }}
{{- $r1 := index $t.primary_l 0 }}
{{- $g1 := index $t.primary_l 1 }}
{{- $b1 := index $t.primary_l 2 }}
{{- $r2 := index $t.primary_r 0 }}
{{- $g2 := index $t.primary_r 1 }}
{{- $b2 := index $t.primary_r 2 }}
{{- $rd := subf $r2 $r1 }}
{{- $gd := subf $g2 $g1 }}
{{- $bd := subf $b2 $b1 }}
{{- $rdp := divf $rd 100 }}
{{- $gdp := divf $gd 100 }}
{{- $bdp := divf $bd 100 }}
{{- $primary := dict }}
{{- range $p := list 0 17 33 50 67 83 100 }}
{{- /* double # because ff is weird and #n already does something */}}
{{- $_ := set $primary (toString $p) (printf "##%02x%02x%02x" (round (addf $r1 (mulf $rdp $p)) 0 | int) (round (addf $g1 (mulf $gdp $p)) 0 | int) (round (addf $b1 (mulf $bdp $p)) 0 | int)) }}
{{- end }}
{{- /* \x1b is broken in json */}}
{{- $primary1_ansi := (printf "\\u001b[38;2;%d;%d;%dm" $r1 $g1 $b1) }}
{{- $primary2_ansi := (printf "\\u001b[38;2;%d;%d;%dm" $r2 $g2 $b2) }}
{{- $reset_ansi := "\\u001b[0m" -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
  	"separator": " {{$st}} ",
  },
  "modules": [
    "title",
    {
    	"type": "separator",
    	"color": "{{index $primary "100"}}",
    	"string": "{{$st}}",
    },
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Userspace { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
    {
   		"type": "os",
    	"keyColor": "blue", // gradient needs organisation
    },
    "locale",
    "users",
	"lm",
  	{ "type": "shell", "format": "lua:shell = ..." },
   	{ "type": "terminal", "format": "lua:return shell.prettyName .. ' {{$primary2_ansi}}{{$s}}{{$reset_ansi}} ' .. (...).prettyName" }, 	   	
	{ "type": "wm", "key": "WM"},
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Themes { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
   	{ "type": "theme", "format": "lua:theme = ..." },
   	{ "type": "wmtheme", "key": "Theme", "format": "lua:return theme.theme1 .. ' {{$primary2_ansi}}{{$s}}{{$reset_ansi}} ' .. (...).result" },
	{ "type": "icons", "format": "lua:icons = ..." },
	{ "type": "cursor", "key": "Icon/Cursor", "format": "lua:return icons.icons2 .. ' {{$primary2_ansi}}{{$s}}{{$reset_ansi}} ' .. (...).theme .. ' ' .. (...).size" },
	"font",   
   	"terminalfont",
   	"terminaltheme",   	        
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Low-Level { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
    "bios",
    "bootmgr",
    "kernel",
    {{- /* TODO collapse maybe show only version */}}
    "vulkan",
    "opengl",
    "opencl",
    "initsystem",
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Hardware { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
    "board",
    "cpu",
{{- /* TODO collapse. don't know how to handle the seperator. maybe put it before and then use a ternary to check if a previous version exists. so if cpucache is the var, do cpucache ? cpucache + "sep" : "" (c pseudocode) and then add the rest to that */}}
    { 
    	"type": "cpucache", 
    },
    "gpu",
    { "type": "memory", "format": "lua:memory = ..." },
    { "type": "swap", "key": "Memory", "format": "lua:return memory.used .. '/' .. memory.total .. ' {{$primary2_ansi}}{{$s}}{{$reset_ansi}} ' .. (...).used .. '/' .. (...).total" },
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Storage { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
{{- /* TODO collapse */}}
	"disk",
	"physicaldisk",
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Networking { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
    "localip",
    "dns",
    "wifi",
    "bluetooth",
    { "type": "custom", "format": "{ {{- index $primary "0" -}} }{{$st}}{ {{- index $primary "17" -}} }{{$st}}{ {{- index $primary "33" -}} }{{$st}} { {{- index $primary "50" -}} }Input/Output { {{- index $primary "67" -}} }{{$st}}{ {{- index $primary "83" -}} }{{$st}}{ {{- index $primary "100" -}} }{{$st}}"},
    "sound",
    "gamepad",
{{- /* TODO collapse */}}
    "mouse",
{{- /* TODO collapse */}}
    "keyboard",
    "display",
    "break",
    "colors"
  ]
}
