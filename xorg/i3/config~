# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $exec-noid exec --no-startup-id
set $mod Mod4

set $left-screen HDMI-0
set $left-width 2560
set $left-height 1440
set $left-rate 120
set $left-scale 1

set $right-screen DP-0
set $right-width 2560
set $right-height 1440
set $right-rate 120
set $right-scale 1

set $down-enable 1
set $down-screen HDMI-0



font pango:DepartureMono Nerd Font Mono 8

# $ dex --autostart --environment i3

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


floating_modifier $mod

#tiling_drag enable

bindsym $mod+Return exec kitty

bindsym $mod+Shift+q kill

bindsym $mod+i $exec-noid dmenu_run -fn 'DepartureMono Nerd Font Mono-11'

bindsym $mod+a focus left
bindsym $mod+s focus down
bindsym $mod+w focus up
bindsym $mod+d focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+a move left
bindsym $mod+Shift+s move down
bindsym $mod+Shift+w move up
bindsym $mod+Shift+d move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f gaps inner all set 0; gaps outer all set 0  
bindsym $mod+Shift+g gaps inner all set 20; gaps outer all set 5 

bindsym $mod+j set $font pango:DepartureMono Nerd Font Mono:style=Bold 16
bindsym $mod+k set $font pango:DepartureMono Nerd Font Mono:style=Bold 8

bindsym $mod+p layout stacking
bindsym $mod+o layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+m $exec-noid /home/maksz/.config/i3/vertical.sh
bindsym $mod+n $exec-noid /home/maksz/.config/i3/horizontal.sh

bindsym $mod+z focus parent
bindsym $mod+x focus child

set $wsn workspace number
set $mct move container to
bindsym $mod+1 $wsn 1
bindsym $mod+2 $wsn 2
bindsym $mod+3 $wsn 3
bindsym $mod+4 $wsn 4
bindsym $mod+5 $wsn 5
bindsym $mod+6 $wsn 6
bindsym $mod+7 $wsn 7
bindsym $mod+8 $wsn 8
bindsym $mod+9 $wsn 9
bindsym $mod+0 $wsn 10

bindsym $mod+Shift+1 $mct $wsn 1
bindsym $mod+Shift+2 $mct $wsn 2
bindsym $mod+Shift+3 $mct $wsn 3
bindsym $mod+Shift+4 $mct $wsn 4
bindsym $mod+Shift+5 $mct $wsn 5
bindsym $mod+Shift+6 $mct $wsn 6
bindsym $mod+Shift+7 $mct $wsn 7
bindsym $mod+Shift+8 $mct $wsn 8
bindsym $mod+Shift+9 $mct $wsn 9
bindsym $mod+Shift+0 $mct $wsn 10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Kill xserver?' -B 'Yes' 'i3-msg exit'"

mode "resize" {
        bindsym a resize shrink width 10 px or 10 ppt
        bindsym s resize grow height 10 px or 10 ppt
        bindsym w resize shrink height 10 px or 10 ppt
        bindsym d resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

$exec-noid "xrandr --output DP-0 --mode 2560x1440 --rate 120 --pos 0x0 --rotate normal" 
$exec-noid "xrandr --output HDMI-0 --mode 2560x1440 --rate 120 --pos 2560x0 --rotate right --primary"
$exec-noid "xrandr --output HDMI-1 --mode auto --rate 60 --pos -1024x0 --rotate normal>
gaps inner 20
gaps outer 5

workspace 1 output HDMI-0
workspace 9 output HDMI-1
workspace 9 gaps inner 10
workspace 9 gaps outer 3

$exec-noid "i3-msg \"workspace 9\""
$exec-noid "kitty cava"
$exec-noid "kitty tty-clock"

$exec-noid "i3-msg \"workspace 1\""

smart_gaps off
smart_borders on

exec --no-startup-id nm-applet

$exec-noid "setxkbmap pl"

# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

$exec-noid "/home/maksz/activitywatch/aw_qt"

$exec-noid "picom"
 
$exec-noid "feh --bg-scale /home/user/Pictures/wpaper.jpg"

$exec-noid "/usr/libexec/xdg-desktop-portal-gtk &"

$exec-noid "polybar"

exec "/usr/libexec/polkit-mate-authentication-agent-1 &"

default_border pixel 0

for_window [class="^.*"] border pixel 0
