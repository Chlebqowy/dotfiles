# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $exec-noid exec --no-startup-id
set $mod Mod4

font pango:Iosevka Nerd Font Mono 8

# $ dex --autostart --environment i3

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


floating_modifier $mod

#tiling_drag enable

bindsym $mod+Return exec kitty
bindsym $mod+Shift+Return exec firefox

bindsym $mod+Shift+q kill

bindsym $mod+i $exec-noid dmenu_run -fn 'Iosevka Nerd Font Mono-11' -sb "#227744" # -r 8 && rofi -show run

bindsym $mod+a focus left
bindsym $mod+s focus down
bindsym $mod+w focus up
bindsym $mod+d focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+a move left
bindsym $mod+Shift+s move down
bindsym $mod+Shift+w move up
bindsym $mod+Shift+d move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Ctrl+Left exec xdotool mousemove 1280 720
bindsym $mod+Ctrl+A exec xdotool mousemove 1280 720

bindsym $mod+Ctrl+Right exec xdotool mousemove 3840 720
bindsym $mod+Ctrl+D exec xdotool mousemove 3840 720

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f exec "~/scripts/lock-in-mode.sh on"
bindsym $mod+Ctrl+f exec "~/scripts/lock-in-mode.sh off"

bindsym $mod+j set $font pango:Iosevka Nerd Font Mono:style=Bold 16
bindsym $mod+k set $font pango:Iosevka Nerd Font Mono:style=Bold 8

bindsym $mod+p layout stacking
bindsym $mod+o layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+m exec flameshot gui
bindsym $mod+shift+m exec flameshot screen
bindsym $mod+ctrl+m exec flameshot launcher

bindsym $mod+x focus parent
bindsym $mod+z focus child

set $wsn workspace number
set $mct move container to

set $ws1 "1: Notatki"
set $ws2 "2: Firefox"
set $ws3 "3: Kod"
set $ws4 "4: Losowe"
set $ws5 "5: Discord"

bindsym $mod+1 $wsn $ws1
bindsym $mod+2 $wsn $ws2
bindsym $mod+3 $wsn $ws3
bindsym $mod+4 $wsn $ws4
bindsym $mod+5 $wsn $ws5

bindsym $mod+Shift+1 $mct $wsn $ws1
bindsym $mod+Shift+2 $mct $wsn $ws2
bindsym $mod+Shift+3 $mct $wsn $ws3
bindsym $mod+Shift+4 $mct $wsn $ws4
bindsym $mod+Shift+5 $mct $wsn $ws5

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Kill i3?' -B 'Yes' 'i3-msg exit'"

bindsym $mod+equal resize grow width 100 px
bindsym $mod+shift+equal resize grow height 100 px
bindsym $mod+ctrl+equal resize grow width 20 px
bindsym $mod+ctrl+shift+equal resize grow height 20 px
bindsym $mod+minus resize shrink width 100 px
bindsym $mod+shift+minus resize shrink height 100 px
bindsym $mod+ctrl+minus resize shrink width 20 px
bindsym $mod+ctrl+shift+minus resize shrink height 20 px

gaps inner 20
gaps outer 5
# make sure it's the same as in lock-in-mode

smart_gaps off
#smart_borders on

exec --no-startup-id nm-applet

$exec-noid "setxkbmap pl"

# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# exec "bash ~/.config/i3/screens.sh horizontal"

$exec-noid "xrandr --output eDP-1 --mode 1920x1080 --rate 60 --pos 0x0 --rotate normal"

$exec-noid "~/activitywatch/aw_qt" # optional
$exec-noid "bash ~/scripts/fehpaperdyn.sh"

$exec-noid "picom"
$exec-noid "polybar"
$exec-noid "dunst"

title_align center

for_window [class="^.*"] border pixel 8
client.focused #339955 #227744 #ffffff #222222 #3f8f62
client.unfocused #333333 #222826 #888888 #222222 #5b5757
client.focused_inactive #336644 #335544 #eeeeee #222222 #5b5757
for_window [class="dunst"] border pixel 0

workspace $ws1 output eDP-1
workspace $ws2 output eDP-1
workspace $ws3 output eDP-1
workspace $ws4 output eDP-1
workspace $ws5 output eDP-1

assign [class="(?i)steam"] $ws1
assign [class="(?i)firefox"] $ws2
assign [class="(?i)discord"] $ws4

$exec-noid i3-msg 'workspace $ws1'

bar {
  workspace_buttons no
  tray_output none
  #position bottom
  position bottom
  #output primary
  output eDP-1
  id 1
  #font pango:Iosevka Nerd Font 12
  font pango:Iosevka Nerd Font 11
  status_command "chlebqowy-workspace-bar"
  colors {
    background #222222aa
  }
  height 32
  # inconsistent with polybar because it felt bigger. probably because of shadows
  #height 36
  # padding 9px # 6 pt at 107 dpi, polybar is 24 pt and font size is 12 pt so I wanted to make them equal. divide that by 2.
}

exec "systemctl --user start i3-session.target"
$exec-noid "/usr/libexec/xdg-desktop-portal-gtk &"
exec "/usr/libexec/polkit-mate-authentication-agent-1 &"
