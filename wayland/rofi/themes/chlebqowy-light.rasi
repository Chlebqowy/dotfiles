* {
	background:                  #F3EADAAA;
	normal-background:			 #00000000;
	alternate-background:        @normal-background;
	selected-background: 	 	 @gray;
	gray:						 #6f6b60;
	
    foreground:                  #0A050F;
    normal-foreground:           @foreground;
    alternate-foreground:        @foreground;
    selected-foreground:         @white-text;
    white-text:					 #e7e3e0;

	accent: 					 #ef8528;
	secondary:					 #2892ef;
	bordercolor:                 @foreground;
    
    red:                         #933232;
    blue:                        #323293;

    background-color:            rgba ( 0, 0, 0, 0 % );
}
window {
	width:			  400px;
	height:			  800px;
    background-color: @background;
    border:           0; //use sway border
    padding:          5;
}
mainbox {
    border:  0;
    padding: 0;
}

textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
	border:       3px 0px 0px 0px;
    border-color: @secondary;
    spacing:      2px;
    scrollbar:    false;
    padding:      2px 0px 2px;
}
element {
    border:  0;
    padding: 1px;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
    horizontal-align: 0.5;
}
element-text selected.normal {
	font: "Iosevka Nerd Font Bold 12";
}
element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element selected.normal {
    background-color: @selected-background;
    text-color:       @selected-foreground;
}
element alternate.normal {
    background-color: @alternate-background;
    text-color:       @alternate-foreground;
}
scrollbar {
    enabled: false;
}
inputbar {
    spacing: 0px;
    text-color: @white-text;
    background-color:@background;
    padding: 1px;
    border: 0px;
    scrollbar: false;
}
inputbar {
    children:   [ textbox-special-seperator-1,textbox-special-seperator-2,prompt,textbox-seperator,entry,textbox-special-seperator-3,textbox-special-seperator-4];
}
entry {
    spacing:    0;
    text-color: inherit;
    background-color: @gray;
}
prompt {
    spacing:    0;
    text-color: inherit;
    background-color: @gray;
}
textbox-seperator {
    expand:     false;
    str:        " \\ ";
    margin:     0em 0em 0em 0em;
    text-color: @accent;
    background-color: @gray;
}
textbox-special-seperator-1 {
    expand:     false;
    str:        " ";
    margin:     0em 0em 0em 0em;
    text-color: @accent;
    background-color: @normal-background;
}
textbox-special-seperator-2 {
    expand:     false;
    str:        " ";
    margin:     0em 0em 0em 0em;
    text-color: @accent;
    background-color: @gray;
}
textbox-special-seperator-3 {
    expand:     false;
    str:        " ";
    margin:     0em 0em 0em 0em;
    text-color: @accent;
    background-color: @gray;
}
textbox-special-seperator-4 {
    expand:     false;
    str:        " ";
    margin:     0em 0em 0em 0em;
    text-color: @accent;
    background-color: @normal-background;
}
