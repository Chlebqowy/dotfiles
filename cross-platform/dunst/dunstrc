[global]
monitor = 0
enable_posix_regex = true
width = 500
height = (100, 400)
notification_limit = 5
origin = top-center
scale = 1
icon_corner_radius = 20
corner_radius = 30
text_icon_padding = 10
frame_width = 8
gap_size = 15
sort = urgency_descending
idle_threshold = 0
font = mono 12
; make bg half-transparent
format = "<b>%a</b> %c\n%s\n%b%p"
stack_duplicates = false
icon_theme = "Mint-X-Aqua, Cosmic, Adwaita, Memphis98, breeze_dark"
browser = "firefox"
mouse_left_click = do_action, open_url, remove_current
mouse_right_click = remove_current
mouse_middle_click = close_all
ignore_dbusclose = true
vertical_alignment = top
alignment = center
markup = full
frame_color = "#7fffb2"
background = "#28282855"
timeout = 5
; idle_threshold = 10

[discord]
appname="[Dd]iscord"
frame_color = "#7289da"
format = "<b>%a</b>\n%s\n%b%p"
[firefox]
appname="[Ff]irefox"
frame_color = "#E66000"
format = "<b>%a</b>\n%s\n%b%p"
